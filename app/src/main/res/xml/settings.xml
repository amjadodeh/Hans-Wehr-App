<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Settings">
        <Preference
            app:key="clear_cache_pref"
            app:summary="Clears images stored using the local cache (memory) of your phone"
            app:title="Clear Image Cache" />
        <Preference
            app:key="clear_search_history_pref"
            app:summary="Clears the users search history stored on the device"
            app:title="Clear Search History" />
    </PreferenceCategory>

    <PreferenceCategory app:title="About">
        <Preference
            app:key="version_pref"
            app:selectable="false"
            app:title="Version" />
        <Preference
            app:key="source_pref"
            app:summary="github.com/amjadodeh/Hans-Wehr-App"
            app:title="Source code">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/amjadodeh/Hans-Wehr-App" />
        </Preference>
    </PreferenceCategory>

</PreferenceScreen>
