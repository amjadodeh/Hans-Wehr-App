<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Search">
        <Preference
            app:key="clear_search_history_pref"
            app:summary="Removes the recent searches shown under the search box"
            app:title="Clear search history" />
    </PreferenceCategory>

    <PreferenceCategory app:title="About">
        <Preference
            app:key="version_pref"
            app:selectable="false"
            app:title="Version" />
        <Preference
            app:key="source_pref"
            app:summary="github.com/amjadodeh/Hans-Wehr-App"
            app:title="Source code">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/amjadodeh/Hans-Wehr-App" />
        </Preference>
    </PreferenceCategory>

</PreferenceScreen>
